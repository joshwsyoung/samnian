# Copy this file to .env.local for local dev (Vercel: set these as Project
# Environment Variables instead — see README.md).

# Postgres connection string. In Supabase: Project Settings > Database >
# Connection string > "Transaction" pooler (recommended for serverless).
DATABASE_URL="postgresql://postgres.xxxxx:PASSWORD@aws-0-eu-west-2.pooler.supabase.com:6543/postgres"

# Any long random string — used to sign session cookies. Generate one with:
#   openssl rand -base64 32
SESSION_SECRET="change-me-to-a-long-random-string"

# Outbound email (verification codes, password resets). Any SMTP provider
# works. If left unset, emails are logged to the server console instead of
# sent — fine for local dev, not for production.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="\"TalkTable\" <unable.to.reply.to.this@gmail.com>"

# Profile image uploads. Vercel: Project > Storage > Blob > Connect — this
# is injected automatically, you don't need to set it by hand there.
BLOB_READ_WRITE_TOKEN=""

# Optional: only needed if you want email links (password reset) to use a
# fixed origin instead of being inferred from the incoming request's Host
# header.
# NEXT_PUBLIC_BASE_URL="https://talktable.example.com"
