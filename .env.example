# Copy this file to .env.local for local dev (Vercel: set these as Project
# Environment Variables instead — see README.md).

# Postgres connection string, for this app's own data (everything except
# auth). In Supabase: Project Settings > Database > Connection string >
# "Transaction" pooler (recommended for serverless).
DATABASE_URL="postgresql://postgres.xxxxx:PASSWORD@aws-0-eu-west-2.pooler.supabase.com:6543/postgres"

# Supabase Auth — handles login, sessions, and sending verification /
# password-reset emails itself, so no SESSION_SECRET or SMTP config is
# needed. Both come from Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL="https://xxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="the anon / publishable key"

# Server-only. The service_role secret (same page, further down) — lets
# the app delete a user's auth account (Delete Account) and fix a user's
# login email (admin panel). Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY="the service_role key"

# Profile image uploads. Vercel: Project > Storage > Blob > Connect — this
# is injected automatically, you don't need to set it by hand there.
BLOB_READ_WRITE_TOKEN=""

# Optional: only needed if you want email links (password reset, email
# confirmation) to use a fixed origin instead of being inferred from the
# incoming request's Host header.
# NEXT_PUBLIC_BASE_URL="https://samnian.example.com"
